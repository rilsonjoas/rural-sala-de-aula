DATABASE_URL=jdbc:postgresql://localhost:5432/rural_sala_de_aula
DATABASE_USERNAME=sala
DATABASE_PASSWORD=sala
PORT=8080
# true = cria usuarios e turmas de exemplo (senha1234). Nunca em producao.
APP_SEED_ENABLED=true
# true somente atras de HTTPS
SESSION_COOKIE_SECURE=false
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50.0
